---
/** Chaque page de sujet (src/content/guides), version zh. */
import ContentPage from '../../components/ContentPage.astro';
import { GUIDES } from '../../lib/pages';
import type { GuideDef } from '../../lib/page-types';
export function getStaticPaths() {
  return GUIDES.filter((p) => p.zh).map((page) => ({ params: { slug: page.zh!.slug }, props: { page } }));
}
const { page } = Astro.props as { page: GuideDef };
---
<ContentPage page={page} lang="zh" />
