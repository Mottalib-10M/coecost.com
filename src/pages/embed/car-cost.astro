---
/** Page à intégrer (iframe) : le simulateur de coût complet seul. noindex, hors sitemap (astro.config). */
import '../../styles/global.css';
import Tool from '../../components/Tool.astro';
import { SITE_URL, SITE_NAMES, LANG_TAGS } from '../../data/site-config';
const lang = 'en';
---
<!doctype html>
<html lang={LANG_TAGS[lang]}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Singapore car cost calculator with the latest COE (embeddable)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><Tool kind="cost" lang={lang} idPrefix="embed" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES[lang]}</a> · contains information from data.gov.sg (Land Transport Authority) made available under the Singapore Open Data Licence version 1.0 · not affiliated with LTA</p>
  </body>
</html>
