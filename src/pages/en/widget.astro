---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/car-cost/" title="Singapore car cost calculator with the latest COE" width="100%" height="900" style="border:0;max-width:900px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Singapore car cost calculator on your site, 2026" description="Car clubs, forums and blogs can embed the 2026 Singapore car cost calculator, with the latest COE premium, ARF, rebates and road tax, in one line of code. Free." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. The embedded calculator follows every COE exercise.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>The calculator runs in your visitor’s browser and sends nothing to us or to you. Please keep the line under it: it carries the data licence notice and the link to the method.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/car-cost/" title="Singapore car cost calculator with the latest COE" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
