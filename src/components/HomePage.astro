---
/**
 * Accueil : le tableau des cinq primes du dernier exercice, le simulateur de coût complet, la réponse repliée,
 * la phrase de valeur, les exercices de l'année, les moyennes annuelles depuis 2010, ce que chaque taxe ajoute,
 * les familles de pages, les textes longs en accordéons, la FAQ.
 * Texte : src/content/home.ts ; chiffres : data.gov.sg (Singapore Open Data Licence) et params-2026.json.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import { HOME } from '../content/home';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { GROUPS } from '../i18n/nav';
import { helpers, sourceList } from '../lib/helpers';
import { GUIDES } from '../lib/pages';
import { LATEST, PREVIOUS, CATS, catName, catShort, premium, exName, money, signed, num, lastN, yearly, day, FETCHED, NEXT_EX } from '../lib/data';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const path = route('home', lang);
const h = helpers(lang);
const zh = lang === 'zh';
const sources = sourceList(HOME.sources, lang);
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const board = CATS.map((c) => ({ c, v: premium(LATEST, c), d: premium(LATEST, c) - premium(PREVIOUS, c) }));
const recent = lastN(24).map((e) => [exName(e, lang, true), ...CATS.map((c) => money(premium(e, c), lang))]);
const years = yearly('A').map((a, i) => { const b = yearly('B')[i]; return [String(a.year), money(a.mean, lang), money(b.mean, lang), money(a.max, lang), money(b.max, lang)]; }).reverse();
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-3">
    <h1 class="text-[1.7rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
  </header>
  <ul data-chrome class="mb-4 grid grid-cols-3 gap-px overflow-hidden rounded-lg border border-navy-200 bg-navy-200 sm:grid-cols-5" aria-label={zh ? '最新一轮拥车证价格' : 'Latest COE premiums'}>
    {board.map((b) => (
      <li class="bg-white px-3 py-2">
        <span class="block text-xs font-medium text-navy-600">{catShort(b.c, lang)}</span>
        <span class="tabular-nums block text-lg font-bold text-navy-900">{money(b.v, lang)}</span>
        <span class={`tabular-nums block text-xs ${b.d > 0 ? 'text-accent-700' : 'text-navy-600'}`}>{signed(b.d, lang)}</span>
      </li>
    ))}
  </ul>
  <div data-outil data-chrome><Tool kind="cost" lang={lang} idPrefix="home" /></div>
  <p class="mt-3 text-sm text-navy-600"><a href={route('method', lang)} class="underline">{zh ? '计算方法与局限' : 'Method and limits'}</a> · <a href={route('about', lang)} class="underline">{zh ? '谁发布本站' : 'Who publishes this site'}</a> · {zh ? `拥车证结果读取于${day(FETCHED, lang)}` : `COE results read on ${day(FETCHED, lang)}`}</p>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <p class="my-6 border-l-4 border-accent-500 pl-4 text-navy-800"><strong>{x.valeur}</strong></p>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{x.recentTitle}</h2>
    <p class="mt-2 text-navy-700">{x.recentIntro}</p>
    <div data-chrome><Fragment set:html={h.table([zh ? '轮次' : 'Exercise', ...CATS.map((c) => catShort(c, lang))], recent, zh ? '最近24轮，按时间倒序。来源：陆路交通管理局，经 data.gov.sg（新加坡开放数据许可证 1.0 版）。' : 'Last 24 exercises, newest first. Source: Land Transport Authority via data.gov.sg (Singapore Open Data Licence 1.0).', ['l', 'r', 'r', 'r', 'r', 'r'])} /></div>
  </section>
  <section class="mt-10"><Body html={x.why(h)} path={path} lang={lang} /></section>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{x.yearsTitle}</h2>
    <p class="mt-2 text-navy-700">{x.yearsIntro}</p>
    <div data-chrome><Fragment set:html={h.table([zh ? '年份' : 'Year', zh ? 'A类平均' : 'Cat A average', zh ? 'B类平均' : 'Cat B average', zh ? 'A类最高' : 'Cat A high', zh ? 'B类最高' : 'Cat B high'], years, zh ? '每年所有轮次的平均与最高价（当年为已进行的轮次）。来源：data.gov.sg。' : 'Average and highest premium of all exercises in each year (the current year counts the exercises held so far). Source: data.gov.sg.', ['l', 'r', 'r', 'r', 'r'])} /></div>
  </section>
  <section class="mt-10" data-chrome>
    {GROUPS.map((g) => {
      const list = GUIDES.filter((p) => p.group === g.id && hasRoute(p.id, lang));
      return list.length > 0 && (
        <div class="mb-6">
          <h2 class="text-xl font-bold text-navy-900">{g.label[lang]}</h2>
          <ul class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2 lg:grid-cols-3">
            {list.map((p) => <li><a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{p[lang]!.nav}</a><span class="block text-navy-600">{p[lang]!.card}</span></li>)}
          </ul>
        </div>
      );
    })}
  </section>
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{x.foldTitle}</h2>
    {x.sections(h).map((s) => <details class="fold"><summary><h3 class="fold-h">{s.title}</h3></summary><div class="pb-4"><Body html={s.html} path={path} lang={lang} /></div></details>)}
  </section>
  {NEXT_EX && <p class="mt-8 text-sm text-navy-600">{zh ? `下一轮竞标：${day(NEXT_EX.start, lang)}中午12时开始，${day(NEXT_EX.end, lang)}下午4时结束（陆路交通管理局2026年时间表）。` : `Next exercise: opens ${day(NEXT_EX.start, lang)} at 12 noon, closes ${day(NEXT_EX.end, lang)} at 4 pm (LTA schedule for 2026).`}</p>}
</PageLayout>
